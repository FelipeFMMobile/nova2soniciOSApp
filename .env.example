STS_ENV=development
STS_GATEWAY_ADDRESS=127.0.0.1:8080
STS_DEVELOPMENT_TOKEN=change-me
STS_PROVIDER=fake

# Nova 2 Sonic through the local Python transport bridge.
STS_NOVA_BRIDGE_URL=ws://127.0.0.1:8091
STS_NOVA_MAX_SESSION_AGE=7m30s
AWS_PROFILE=sts-poc
AWS_REGION=us-east-1
NOVA_MODEL_ID=amazon.nova-2-sonic-v1:0
NOVA_VOICE_ID=carolina

STS_DATABASE_PATH=./data/sts.sqlite
# Optional MCP stdio subprocess. Build it with make mcp-build first.
# STS_MCP_COMMAND=/absolute/path/StsModel/bin/mcp-notes
STS_MCP_ARGS=["-db","./data/sts.sqlite"]
STS_MCP_ALLOWED_TOOLS=notes.create,notes.list,notes.delete
STS_MCP_TIMEOUT=10s
STS_READ_TIMEOUT=15s
STS_WRITE_TIMEOUT=15s
STS_IDLE_TIMEOUT=90s
STS_MAX_EVENT_BYTES=524288
STS_MAX_SESSIONS=16
STS_TURN_TIMEOUT=30s

# Multiple trusted stdio servers: JSON array; see docs/mcp-servers.example.json.
# Do not combine STS_MCP_SERVERS with STS_MCP_COMMAND.
STS_MCP_SERVERS=
# Optional private tool payload evidence (absolute JSONL path; ignored by Git).
STS_MCP_EVIDENCE_PATH=

# Alternative local LiteLLM MCP backend. Do not combine with stdio variables.
STS_MCP_BACKEND=stdio
# STS_LITELLM_MCP_URL=http://127.0.0.1:4000
# STS_LITELLM_API_KEY=generated-service-key
# STS_MCP_CONTEXT_SECRET=64-lowercase-hex-characters
# STS_LITELLM_MCP_SERVERS=[{"alias":"memo","server_id":"sts-notes","allowed_tools":["notes.create","notes.list","notes.delete"],"policies":{"notes.create":"explicit_intent","notes.list":"read_only","notes.delete":"confirm_later"}}]
