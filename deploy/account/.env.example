# make dev --account creates missing random secrets once in .env (0600).
STS_IDENTITY_PROVIDER=fake
STS_IDENTITY_DB_PASSWORD=replace-with-random-secret
STS_PROFILE_DB_PASSWORD=replace-with-random-secret
STS_USAGE_DB_PASSWORD=replace-with-random-secret
STS_IDENTITY_SERVICE_TOKEN=replace-with-at-least-32-random-characters
STS_PROFILE_SERVICE_TOKEN=replace-with-at-least-32-random-characters
STS_ACCOUNT_CONTEXT_SECRET=replace-with-64-hex-characters
STS_LEGACY_CONTEXT_SECRET=replace-with-another-64-hex-characters
STS_CLIENT_CODE_KEY=replace-with-another-64-hex-characters
STS_TOKEN_ENCRYPTION_KEY=replace-with-another-64-hex-characters
LITELLM_MASTER_KEY=sk-replace-with-random-secret
STS_ACCOUNT_SERVICE_KEY=sk-replace-with-random-secret
STS_PERSONAL_SERVICE_KEY=sk-replace-with-random-secret
# Existing Cognito resources. make dev checks their configuration before seeding.
STS_COGNITO_REGION=us-east-1
STS_COGNITO_USER_POOL_ID=
STS_COGNITO_CLIENT_ID=
STS_COGNITO_DOMAIN=
STS_COGNITO_ISSUER=
