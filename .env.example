STS_ENV=development
STS_GATEWAY_ADDRESS=127.0.0.1:8080
STS_DEVELOPMENT_TOKEN=change-me
STS_PROVIDER=fake

# Qwen on RunPod. Leave empty while STS_PROVIDER=fake.
STS_QWEN_REALTIME_URL=wss://your-pod-8091.proxy.runpod.net/v1/realtime
STS_QWEN_CHAT_URL=https://your-pod-8091.proxy.runpod.net/v1/chat/completions
STS_QWEN_API_KEY=

STS_DATABASE_PATH=./data/sts.sqlite
STS_READ_TIMEOUT=15s
STS_WRITE_TIMEOUT=15s
STS_IDLE_TIMEOUT=90s
STS_MAX_EVENT_BYTES=524288

