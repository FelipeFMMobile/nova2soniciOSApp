{
  "name": "sts-qwen-omni",
  "cloudType": "SECURE",
  "computeType": "GPU",
  "gpuCount": 1,
  "gpuTypeIds": ["NVIDIA H200"],
  "dataCenterIds": ["US-GA-2"],
  "dataCenterPriority": "custom",
  "containerDiskInGb": 50,
  "networkVolumeId": "REPLACE_WITH_NETWORK_VOLUME_ID",
  "volumeMountPath": "/workspace",
  "ports": ["8091/http", "22/tcp"],
  "globalNetworking": true,
  "env": {
    "VLLM_API_KEY": "SET_IN_RUNPOD_CONSOLE",
    "QWEN_MODEL": "Qwen/Qwen3-Omni-30B-A3B-Instruct",
    "QWEN_MODEL_REVISION": "26291f7",
    "MODEL_CACHE": "/workspace/models",
    "MAX_MODEL_LEN": "32768"
  }
}

