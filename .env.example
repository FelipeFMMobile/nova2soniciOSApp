STS_ENV=development
STS_GATEWAY_ADDRESS=127.0.0.1:8080
STS_DEVELOPMENT_TOKEN=change-me
STS_PROVIDER=fake

# Nova 2 Sonic through the local Python transport bridge.
STS_NOVA_BRIDGE_URL=ws://127.0.0.1:8091
STS_NOVA_MAX_SESSION_AGE=7m30s
AWS_PROFILE=sts-poc
AWS_REGION=us-east-1
NOVA_MODEL_ID=amazon.nova-2-sonic-v1:0
NOVA_VOICE_ID=carolina

STS_DATABASE_PATH=./data/sts.sqlite
STS_READ_TIMEOUT=15s
STS_WRITE_TIMEOUT=15s
STS_IDLE_TIMEOUT=90s
STS_MAX_EVENT_BYTES=524288
STS_MAX_SESSIONS=16
STS_TURN_TIMEOUT=30s
